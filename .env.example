# Copy this file to .env.local and fill in the values. Next.js does not read .env.example.

# Supabase project (Settings -> API). The publishable/anon key is safe in the browser; data is protected by RLS.
# Never put the service role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Base URL of a third-party API used through Axios (no trailing slash). Not used yet.
NEXT_PUBLIC_API_BASE_URL=
# Request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000
